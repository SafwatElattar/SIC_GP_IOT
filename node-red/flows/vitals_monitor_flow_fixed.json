  {
    "id": "aa0000000000000e",
    "type": "function",
    "z": "aa00000000000000",
    "name": "Replay ordered loss scenarios",
    "func": "const kind = (msg.payload && msg.payload.case) || 'rapid';\nconst device = kind === 'stable' ? 'demo-stable-loss' : 'demo-rapid-loss';\nconst bpmValues = kind === 'stable' ? [79, 80, 81, 80, null] : [70, 78, 89, 103, null];\nlet i = 0;\nfunction sendNext() {\n    if (i >= bpmValues.length) { node.done(); return; }\n    const bpm = bpmValues[i++];\n    const p = { device_id: device, timestamp: new Date().toISOString(), mode: 'simulated' };\n    if (bpm === null) { p.signal_status = 'no_signal'; p.sample_ok = false; }\n    else { p.bpm = bpm; p.spo2_pct = 98.0; p.temp_c = 36.8; p.signal_quality = 0.9; p.contact_ok = true; }\n    node.send({ payload: p, topic: 'demo/vitals' });\n    setTimeout(sendNext, 650);\n}\nsendNext();\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 510,
    "wires": [
      [
        "aa0000000000000f"
      ]
    ]
